# Normalize text in the repository and check it out with LF on every platform.
* text=auto eol=lf

# Images (SVG remains text).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary

# Fonts.
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Documents, archives and media.
*.pdf binary
*.zip binary
*.gz binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.ogg binary
*.wav binary
